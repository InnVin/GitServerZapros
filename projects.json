{
  "InnVin/GitServerZapros": {
    "name": "gsz",
    "dir": "/opt/gsz",
    "branch": "main",
    "after": "bash /opt/gsz/install.sh --refresh"
  },
  "InnVin/DKP": {
    "name": "dkp",
    "dir": "/opt/dkp",
    "branch": "main",
    "after": "if [ -f deploy/after-update.sh ]; then bash deploy/after-update.sh; fi"
  },
  "InnVin/FamilyTree": {
    "name": "familytree",
    "dir": "/root/FamilyTree",
    "branch": "master",
    "after": "bash deploy/update.sh"
  },
  "InnVin/LaF-2.0": {
    "name": "laf",
    "dir": "/opt/laf/app",
    "branch": "master",
    "user": "laf",
    "after": "bash deploy/after-update.sh"
  },
  "InnVin/Avtopodbor": {
    "name": "avto",
    "dir": "/opt/avto",
    "branch": "main",
    "after": "bash deploy/after-update.sh"
  },
  "InnVin/snack": {
    "name": "snack",
    "dir": "/opt/snack",
    "branch": "main",
    "after": "bash deploy/after-update.sh"
  },
  "InnVin/Kvartplata": {
    "name": "kvartplata",
    "dir": "/opt/kvartplata",
    "branch": "main",
    "after": "bash deploy/after-update.sh"
  }
}
